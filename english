        <!-- Topic 1: Kalimat Bersarang -->
        <div id="topic-0" class="tab-content active">
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8 mb-6">
                <div class="flex items-start gap-4 mb-6">
                    <div class="w-14 h-14 gradient-bg rounded-2xl flex items-center justify-center text-white shrink-0">
                        <i class="fa-solid fa-layer-group text-xl"></i>
                    </div>
                    <div class="flex-1">
                        <h2 class="text-2xl sm:text-3xl font-bold mb-2">1. Kalimat Bersarang</h2>
                        <p class="text-slate-600">Kalimat majemuk dengan Main Clause + Subordinate Clause</p>
                        <div class="mt-3 flex items-center gap-2">
                            <span class="text-sm font-medium">Skor:</span>
                            <span class="px-3 py-1 bg-sky-100 text-sky-700 rounded-full text-sm font-semibold" id="score-0">0/5</span>
                        </div>
                    </div>
                </div>
                
                <div class="space-y-4 text-slate-700 mb-8">
                    <div class="bg-sky-50 border-l-4 border-sky-500 p-4 rounded-r-lg">
                        <p class="font-semibold text-sky-900 mb-2">Penjelasan Singkat</p>
                        <p class="text-sm sm:text-base">Kalimat bersarang adalah gabungan 2 klausa dengan kata penghubung. <strong>Main Clause</strong> = klausa utama yang bisa berdiri sendiri. <strong>Sub Clause</strong> = klausa tambahan yang tidak bisa berdiri sendiri, diawali kata: that, which, who, because, although, if, when, while.</p>
                    </div>
                    
                    <div class="bg-slate-50 p-5 rounded-xl border border-slate-200">
                        <h3 class="font-semibold text-lg mb-3">Contoh Struktur:</h3>
                        <div class="space-y-2">
                            <p class="font-medium text-sky-700">[Main Clause] + <span class="bg-yellow-200 px-1 rounded">kata penghubung</span> + [Sub Clause]</p>
                            <p class="text-slate-700">I know <span class="bg-yellow-200 px-1 rounded">that</span> you are busy.</p>
                            <p class="text-sm text-slate-500">→ "I know" = Main Clause, "you are busy" = Sub Clause</p>
                        </div>
                    </div>
                </div>

                <!-- Quiz -->
                <div class="quiz">
                    <h3 class="text-xl font-bold mb-4 flex items-center gap-2">
                        <i class="fa-solid fa-pen-to-square text-sky-600"></i>
                        Latihan: Identifikasi Main Clause & Sub Clause
                    </h3>
                    <div class="space-y-6" id="quiz-0">
                        <!-- Soal akan diisi JS -->
                    </div>
                    <div id="quiz-feedback-0" class="mt-6 hidden"></div>
                </div>
            </div>
        </div>

        <!-- Topic 2: Kata Ganti Orang -->
