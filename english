    <script>
        let currentTopic = 0;
        const totalTopics = 7;
        let scores = [0, 0, 0, 0, 0, 0, 0];
        let totalQuestions = [5, 7, 5, 8, 10, 5, 3];
        let answered = Array(7).fill(null).map(() => new Set());

        // Quiz Data
        const quizData = [
            // Topic 1: Kalimat Bersarang - 5 soal
            [
                {
                    type: 'mc',
                    q: 'Manakah yang merupakan Main Clause dari kalimat: "I think that he is smart"?',
                    options: ['a) I think', 'b) that he is smart', 'c) he is smart'],
                    answer: 'a'
                },
                {
                    type: 'mc',
                    q: 'Kata penghubung yang tepat untuk: "The book ___ I borrowed is new"',
                    options: ['a) because', 'b) which', 'c) although'],
                    answer: 'b'
                },
                {
                    type: 'mc',
                    q: 'Sub Clause dari "She cried because she was sad" adalah:',
                    options: ['a) She cried', 'b) because she was sad', 'c) she was sad'],
                    answer: 'b'
                },
                {
                    type: 'mc',
                    q: 'Pilih kalimat bersarang yang benar:',
                    options: ['a) I am happy and sad', 'b) I know that you study', 'c) She runs fast'],
                    answer: 'b'
                },
                {
                    type: 'mc',
                    q: 'Main Clause dari "Although it rained, we went out" adalah:',
                    options: ['a) Although it rained', 'b) we went out', 'c) it rained'],
                    answer: 'b'
                }
            ],
            // Topic 2: Kata Ganti - 7 soal
            [
                {type: 'mc', q: '"___ are my friends" (untuk 3 orang teman)', options: ['a) He', 'b) She', 'c) They'], answer: 'c'},
                {type: 'mc', q: 'Kata ganti untuk "My mother" adalah:', options: ['a) He', 'b) She', 'c) It'], answer: 'b'},
                {type: 'mc', q: '"___ am learning English" (untuk diri sendiri)', options: ['a) I', 'b) You', 'c) He'], answer: 'a'},
                {type: 'mc', q: 'Kata ganti untuk "The cat" adalah:', options: ['a) He', 'b) She', 'c) It'], answer: 'c'},
                {type: 'fill', q: 'Lengkapi: "___ is a doctor" (untuk ayahmu)', answer: 'he'},
                {type: 'fill', q: 'Lengkapi: "___ are students" (untuk saya dan teman saya)', answer: 'we'},
                {type: 'mc', q: 'Kata ganti untuk "Ali and Budi" adalah:', options: ['a) He', 'b) They', 'c) We'], answer: 'b'}
            ],
            // Topic 3: Tenses - 5 soal
            [
                {type: 'mc', q: 'Tenses yang tepat untuk kebiasaan sehari-hari:', options: ['a) Past Simple', 'b) Present Simple', 'c) Future Simple'], answer: 'b'},
                {type: 'mc', q: '"She is studying now" menunjukkan:', options: ['a) Kebiasaan', 'b) Sedang berlangsung', 'c) Sudah selesai'], answer: 'b'},
                {type: 'mc', q: 'Fungsi Past Simple adalah untuk kejadian:', options: ['a) Yang akan terjadi', 'b) Yang selesai di masa lalu', 'c) Yang sedang terjadi'], answer: 'b'},
                {type: 'mc', q: '"I have finished my homework" adalah contoh:', options: ['a) Present Perfect', 'b) Past Simple', 'c) Future Simple'], answer: 'a'},
                {type: 'mc', q: 'Kalimat "They will come tomorrow" menggunakan:', options: ['a) Present Simple', 'b) Past Simple', 'c) Future Simple'], answer: 'c'}
            ],
            // Topic 4: Verb/Adv/Adj - 8 soal
            [
                {type: 'mc', q: 'Dalam kalimat "He runs quickly", kata "quickly" adalah:', options: ['a) Verb', 'b) Adjective', 'c) Adverb'], answer: 'c'},
                {type: 'mc', q: 'Dalam "She is beautiful", kata "beautiful" adalah:', options: ['a) Verb', 'b) Adjective', 'c) Adverb'], answer: 'b'},
                {type: 'mc', q: 'Dalam "They study hard", kata "study" adalah:', options: ['a) Verb', 'b) Adjective', 'c) Adverb'], answer: 'a'},
                {type: 'mc', q: 'Kata yang menjelaskan kata benda adalah:', options: ['a) Verb', 'b) Adjective', 'c) Adverb'], answer: 'b'},
                {type: 'mc', q: 'Kata "always" dalam "I always eat rice" adalah:', options: ['a) Verb', 'b) Adjective', 'c) Adverb'], answer: 'c'},
                {type: 'mc', q: 'Dalam "The big house", kata "big" adalah:', options: ['a) Verb', 'b) Adjective', 'c) Adverb'], answer: 'b'},
                {type: 'mc', q: 'Kata kerja dalam "She sings beautifully" adalah:', options: ['a) She', 'b) sings', 'c) beautifully'], answer: 'b'},
                {type: 'mc', q: 'Kata "very" dalam "very tall" adalah:', options: ['a) Verb', 'b) Adjective', 'c) Adverb'], answer: 'c'}
            ],
            // Topic 5: Verb 1,2,3 - 10 soal
            [
                {type: 'fill', q: 'Verb 2 dari "go" adalah:', answer: 'went'},
                {type: 'fill', q: 'Verb 3 dari "eat" adalah:', answer: 'eaten'},
                {type: 'fill', q: 'Verb 2 dari "write" adalah:', answer: 'wrote'},
                {type: 'fill', q: 'Verb 3 dari "see" adalah:', answer: 'seen'},
                {type: 'fill', q: 'Verb 2 dari "take" adalah:', answer: 'took'},
                {type: 'fill', q: 'Verb 3 dari "give" adalah:', answer: 'given'},
                {type: 'fill', q: 'Verb 2 dari "come" adalah:', answer: 'came'},
                {type: 'fill', q: 'Verb 3 dari "know" adalah:', answer: 'known'},
                {type: 'fill', q: 'Verb 2 dari "think" adalah:', answer: 'thought'},
                {type: 'fill', q: 'Verb 3 dari "buy" adalah:', answer: 'bought'}
            ],
            // Topic 6: 1 Kalimat Bertenses - 5 soal
            [
                {type: 'mc', q: 'Kalimat Present Simple yang benar:', options: ['a) She play football', 'b) She plays football', 'c) She playing football'], answer: 'b'},
                {type: 'mc', q: 'Kalimat Past Simple yang benar:', options: ['a) I go yesterday', 'b) I went yesterday', 'c) I will go yesterday'], answer: 'b'},
                {type: 'mc', q: 'Kalimat Future Simple yang benar:', options: ['a) I go tomorrow', 'b) I went tomorrow', 'c) I will go tomorrow'], answer: 'c'},
                {type: 'mc', q: '"They ___ English every day" (Present)', options: ['a) study', 'b) studies', 'c) studied'], answer: 'a'},
                {type: 'mc', q: '"We ___ to Bali last week" (Past)', options: ['a) go', 'b) went', 'c) will go'], answer: 'b'}
            ],
            // Topic 7: Kalimat Bersarang Bertenses - 3 soal
            [
                {type: 'mc', q: 'Pilih kalimat kompleks yang benar:', options: ['a) I know that she go to school', 'b) I know that she goes to school', 'c) I know that she going to school'], answer: 'b'},
                {type: 'mc', q: '"He told me that he ___ the exam yesterday"', options: ['a) passed', 'b) pass', 'c) will pass'], answer: 'a'},
                {type: 'mc', q: '"I think that they ___ tomorrow"', options: ['a) come', 'b) came', 'c) will come'], answer: 'c'}
            ]
        ];

        function switchTab(index) {
            currentTopic = index;
            document.querySelectorAll('.tab-content').forEach((content, i) => {
                content.classList.toggle('active', i === index);
            });
            
            document.querySelectorAll('.tab-btn').forEach((btn, i) => {
                btn.classList.toggle('active', i === index);
                if (i === index) {
                    btn.querySelector('span').classList.add('bg-white/30');
                    btn.querySelector('span').classList.remove('bg-slate-200');
                } else {
                    btn.classList.remove('text-white');
                    btn.classList.add('text-slate-600');
                    btn.querySelector('span').classList.remove('bg-white/30');
                    btn.querySelector('span').classList.add('bg-slate-200');
                }
            });

            document.getElementById('current-topic').textContent = index + 1;
            document.getElementById('prev-btn').disabled = index === 0;
            document.getElementById('next-btn').disabled = index === totalTopics - 1;
            
            window.scrollTo({ top: 0, behavior: 'smooth' });
            
            if (!answered[index].size) renderQuiz(index);
        }

        function nextTopic() {
            if (currentTopic < totalTopics - 1) {
                switchTab(currentTopic + 1);
            }
        }

        function prevTopic() {
            if (currentTopic > 0) {
                switchTab(currentTopic - 1);
            }
        }

        function updateProgress() {
            const totalScore = scores.reduce((a, b) => a + b, 0);
            const totalMax = totalQuestions.reduce((a, b) => a + b, 0);
            const percent = Math.round((totalScore / totalMax) * 100);
            
            document.getElementById('total-score').textContent = totalScore;
            document.getElementById('total-percent').textContent = percent + '%';
            document.getElementById('progress-bar').style.width = percent + '%';
        }

        function renderQuiz(topicIndex) {
            const container = document.getElementById(`quiz-${topicIndex}`);
            container.innerHTML = '';
            
            quizData[topicIndex].forEach((item, qIndex) => {
                const div = document.createElement('div');
                div.className = 'bg-slate-50 p-5 rounded-xl border border-slate-200';
                
                if (item.type === 'mc') {
                    div.innerHTML = `
                        <p class="font-medium mb-4">${qIndex + 1}. ${item.q}</p>
                        <div class="space-y-2" data-q="${qIndex}">
                            ${item.options.map((opt, i) => {
                                const letter = String.fromCharCode(97 + i);
                                return `<button class="quiz-option w-full text-left p-3 rounded-lg border-2 border-slate-200 bg-white" onclick="selectOption(${topicIndex}, ${qIndex}, '${letter}')" data-letter="${letter}">${opt}</button>`;
                            }).join('')}
                        </div>
                        <button onclick="checkAnswer(${topicIndex}, ${qIndex})" class="mt-4 px-5 py-2.5 bg-sky-600 hover:bg-sky-700 text-white rounded-lg font-medium transition-all text-sm">Cek Jawaban</button>
                        <div class="feedback mt-3 hidden"></div>
                    `;
                } else if (item.type === 'fill') {
                    div.innerHTML = `
                        <p class="font-medium mb-4">${qIndex + 1}. ${item.q}</p>
                        <div class="flex gap-2 flex-col sm:flex-row">
                            <input type="text" class="answer-input flex-1 px-4 py-2.5 border-2 border-slate-300 rounded-lg" placeholder="Ketik jawaban..." data-q="${qIndex}">
                            <button onclick="checkAnswer(${topicIndex}, ${qIndex})" class="px-5 py-2.5 bg-sky-600 hover:bg-sky-700 text-white rounded-lg font-medium transition-all text-sm whitespace-nowrap">Cek Jawaban</button>
                        </div>
                        <div class="feedback mt-3 hidden"></div>
                    `;
                }
                container.appendChild(div);
            });
        }

        function selectOption(topicIndex, qIndex, letter) {
            const container = document.querySelector(`#quiz-${topicIndex} [data-q="${qIndex}"]`);
            container.querySelectorAll('.quiz-option').forEach(btn => {
                btn.classList.remove('selected');
            });
            container.querySelector(`[data-letter="${letter}"]`).classList.add('selected');
        }

        function checkAnswer(topicIndex, qIndex) {
            if (answered[topicIndex].has(qIndex)) return;
            
            const item = quizData[topicIndex][qIndex];
            const container = document.querySelector(`#quiz-${topicIndex} > div:nth-child(${qIndex + 1})`);
            const feedback = container.querySelector('.feedback');
            let isCorrect = false;
            
            if (item.type === 'mc') {
                const selected = container.querySelector('.quiz-option.selected');
                if (!selected) {
                    feedback.innerHTML = `<div class="bg-amber-50 border border-amber-200 rounded-lg p-3 text-sm text-amber-700">⚠️ Pilih jawaban dulu!</div>`;
                    feedback.classList.remove('hidden');
                    return;
                }
                
                const selectedLetter = selected.dataset.letter;
                isCorrect = selectedLetter === item.answer;
                
                container.querySelectorAll('.quiz-option').forEach(btn => {
                    btn.classList.add('disabled');
                    if (btn.dataset.letter === item.answer) {
                        btn.classList.add('correct');
                    } else if (btn.dataset.letter === selectedLetter && !isCorrect) {
                        btn.classList.add('wrong');
                    }
                });
            } else if (item.type === 'fill') {
                const input = container.querySelector('input');
                const userAnswer = input.value.trim().toLowerCase();
                isCorrect = userAnswer === item.answer.toLowerCase();
                
                input.disabled = true;
                if (isCorrect) {
                    input.classList.add('border-green-500', 'bg-green-50');
                } else {
                    input.classList.add('border-red-500', 'bg-red-50');
                }
            }
            
            if (isCorrect) {
                scores[topicIndex]++;
                feedback.innerHTML = `<div class="bg-green-50 border border-green-200 rounded-lg p-3 flex items-center gap-2 text-sm text-green-700"><i class="fa-solid fa-circle-check"></i><span><strong>Benar!</strong> Jawaban kamu tepat 💚</span></div>`;
            } else {
                const correctAnswer = item.type === 'mc' ? item.options[item.answer.charCodeAt(0) - 97] : item.answer;
                feedback.innerHTML = `<div class="bg-red-50 border border-red-200 rounded-lg p-3 flex items-center gap-2 text-sm text-red-700"><i class="fa-solid fa-circle-xmark"></i><span><strong>Salah.</strong> Jawaban yang benar: ${correctAnswer}</span></div>`;
            }
            
            feedback.classList.remove('hidden');
            container.querySelector('button').disabled = true;
            container.querySelector('button').classList.add('opacity-50', 'cursor-not-allowed');
            answered[topicIndex].add(qIndex);
            
            document.getElementById(`score-${topicIndex}`).textContent = `${scores[topicIndex]}/${totalQuestions[topicIndex]}`;
            updateProgress();
            
            if (answered[topicIndex].size === totalQuestions[topicIndex]) {
                const topicFeedback = document.getElementById(`quiz-feedback-${topicIndex}`);
                const scorePercent = Math.round((scores[topicIndex] / totalQuestions[topicIndex]) * 100);
                topicFeedback.innerHTML = `
                    <div class="bg-gradient-to-r from-sky-500 to-emerald-500 rounded-xl p-5 text-white">
                        <div class="flex items-center gap-3 mb-2">
                            <i class="fa-solid fa-award text-2xl"></i>
                            <div>
                                <p class="font-bold text-lg">Topik Selesai!</p>
                                <p class="text-sm text-white/90">Skor: ${scores[topicIndex]}/${totalQuestions[topicIndex]} (${scorePercent}%)</p>
                            </div>
                        </div>
                        <p class="text-sm text-white/90">${scorePercent >= 80 ? 'Hebat! Kamu menguasai topik ini 🎉' : scorePercent >= 60 ? 'Bagus! Terus berlatih ya 👍' : 'Tetap semangat! Coba pelajari lagi materinya 📚'}</p>
                    </div>
                `;
                topicFeedback.classList.remove('hidden');
            }
        }

        // Init
        switchTab(0);
        updateProgress();
    </script>
