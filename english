                        <div class="mt-3 flex items-center gap-2">
                            <span class="text-sm font-medium">Skor:</span>
                            <span class="px-3 py-1 bg-sky-100 text-sky-700 rounded-full text-sm font-semibold" id="score-1">0/7</span>
                        </div>
                    </div>
                </div>
                
                <div class="overflow-x-auto mb-8">
                    <table class="w-full text-sm sm:text-base">
                        <thead class="bg-sky-50">
                            <tr>
                                <th class="p-3 text-left font-semibold">Pronoun</th>
                                <th class="p-3 text-left font-semibold">Arti</th>
                                <th class="p-3 text-left font-semibold">Penggunaan</th>
                                <th class="p-3 text-left font-semibold">Contoh</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200">
                            <tr><td class="p-3 font-medium text-sky-600">I</td><td class="p-3">Saya</td><td class="p-3">Orang pertama tunggal</td><td class="p-3">I am happy</td></tr>
                            <tr><td class="p-3 font-medium text-sky-600">You</td><td class="p-3">Kamu/Kalian</td><td class="p-3">Orang kedua</td><td class="p-3">You are smart</td></tr>
                            <tr><td class="p-3 font-medium text-sky-600">We</td><td class="p-3">Kami/Kita</td><td class="p-3">Orang pertama jamak</td><td class="p-3">We study together</td></tr>
                            <tr><td class="p-3 font-medium text-sky-600">They</td><td class="p-3">Mereka</td><td class="p-3">Orang ketiga jamak</td><td class="p-3">They play football</td></tr>
                            <tr><td class="p-3 font-medium text-sky-600">He</td><td class="p-3">Dia (Laki-laki)</td><td class="p-3">Orang ketiga tunggal</td><td class="p-3">He is a teacher</td></tr>
                            <tr><td class="p-3 font-medium text-sky-600">She</td><td class="p-3">Dia (Perempuan)</td><td class="p-3">Orang ketiga tunggal</td><td class="p-3">She is beautiful</td></tr>
                            <tr><td class="p-3 font-medium text-sky-600">It</td><td class="p-3">Itu/Dia</td><td class="p-3">Benda/hewan</td><td class="p-3">It is a cat</td></tr>
                        </tbody>
                    </table>
                </div>

                <div class="quiz">
                    <h3 class="text-xl font-bold mb-4 flex items-center gap-2">
                        <i class="fa-solid fa-pen-to-square text-sky-600"></i>
                        Latihan: Pilihan Ganda & Isian
                    </h3>
                    <div class="space-y-6" id="quiz-1"></div>
                    <div id="quiz-feedback-1" class="mt-6 hidden"></div>
                </div>
            </div>
        </div>

        <!-- Topic 3: Tenses -->
        <div id="topic-2" class="tab-content">
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8 mb-6">
                <div class="flex items-start gap-4 mb-6">
                    <div class="w-14 h-14 gradient-bg rounded-2xl flex items-center justify-center text-white shrink-0">
                        <i class="fa-solid fa-clock text-xl"></i>
                    </div>
                    <div class="flex-1">
